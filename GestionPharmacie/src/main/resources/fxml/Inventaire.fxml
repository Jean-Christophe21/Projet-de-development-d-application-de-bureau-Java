<AnchorPane id="AnchorPane" prefHeight="650.0" prefWidth="1000.0" styleClass="inventaire-root" stylesheets="@../styles/inventaire.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tg.univ.lome.epl.controller.InventaireController">
   <children>
      <BorderPane layoutX="171.0" layoutY="55.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="header-block" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label style="-fx-font-weight: bold;" styleClass="page-title" text="Inventaire">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Label styleClass="filter-label" text="Rechercher :" />
                        <TextField fx:id="txtRechercheInventaire" prefWidth="250.0" promptText=" Nom du médicament..." />
                        <Label styleClass="filter-label" text="Catégorie :" />
                        <ComboBox fx:id="cbFiltreCategorie" prefWidth="150.0" promptText="Toutes" />
                        <Button fx:id="btnFiltrer" mnemonicParsing="false" styleClass="btn-secondary" text="Filtrer" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <TableView fx:id="tableInventaire" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn prefWidth="228.00000303983688" text="Médicament" />
                <TableColumn minWidth="0.0" prefWidth="202.3999481201172" text="Catégorie" />
                  <TableColumn minWidth="0.0" prefWidth="207.20001220703125" text="Quantité en stock" />
                  <TableColumn prefWidth="207.20001220703125" text="Seuil minimal" />
                  <TableColumn minWidth="8.00006103515625" prefWidth="158.4000244140625" text="Statut" />
              </columns>
            </TableView>
         </center>
         <bottom>
            <HBox prefHeight="100.0" prefWidth="200.0" styleClass="footer-bar" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label fx:id="lblNombreProduits" styleClass="footer-label" text="Nombre de produits : 0" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
